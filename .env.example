# 蓝妹环境变量模板：复制为 .env 后按需修改。
# docker compose 通过 env_file 加载本文件；程序自身不读取 .env（本地开发需自行导出）。
# 可被环境变量覆盖的键以 internal/config/init.go 的映射表为准（本文件为主要常用项），
# 同名环境变量优先于 config.toml 中的对应项。真实密钥请勿提交到版本库。

# PostgreSQL（含 pgvector 扩展）
LANMEI_DATABASE_URL=postgres://lanmei:lanmei@localhost:5432/lanmei?sslmode=disable

# Redis（Conduit 状态存储）
LANMEI_REDIS_ADDR=localhost:6379

# 网关（反向 WebSocket 服务端，接受 Onebots/NapCat 连接）
# 监听地址，Docker 内使用 0.0.0.0:8080，本地开发可用 127.0.0.1:8080
LANMEI_BOT_GATEWAY_LISTEN_ADDR=0.0.0.0:8080
# 鉴权 token，Onebots/NapCat 连接时需携带此 token；须与它们的 access_token/token 一致
# 留空则不鉴权（仅建议本地开发使用）
LANMEI_BOT_GATEWAY_ACCESS_TOKEN=

# 机器人
LANMEI_BOT_NICKNAME=蓝妹
# 超级用户，格式：platform:userID,逗号分隔；留空则无超管
# 示例：qq:123456,wechat:wxid_xxx,napcat:654321
LANMEI_BOT_SUPER_USERS=
# 意图分析 LLM 调用的独立超时（秒）：意图分析只是路由前置步骤，
# LLM 故障时快速降级；默认 8，0 表示不设独立超时（沿用消息级预算）。
# 消息级预算固定为 20s（internal/bot/bot.go），耗尽会触发"迷糊"兜底回复。
LANMEI_BOT_INTENT_TIMEOUT_SECONDS=8
# 海龟汤出题/判定异步任务最长等待（秒）：命令立即回提示，后台用独立 context 生成，
# 不受消息级 20s 预算约束（适配慢速/推理型 LLM）；默认 120，<=0 时回退固定 120s。
LANMEI_BOT_TURTLE_SOUP_TIMEOUT_SECONDS=120

# LLM（OpenAI 兼容 API，支持 DeepSeek/Qwen/Moonshot/GLM 等）
# 填入 API Key 后角色扮演和意图分析自动启用（留空则仅插件/命令可用）
LANMEI_AI_LLM_API_KEY=
# 接口地址需指向 OpenAI 兼容端点（一般带 /v1）；默认 https://api.openai.com/v1
LANMEI_AI_LLM_BASE_URL=https://api.openai.com/v1
# 对话模型名；默认 gpt-4o-mini
LANMEI_AI_LLM_MODEL=gpt-4o-mini
# 单次回复最大输出 token 数；默认 4096
LANMEI_AI_LLM_MAX_TOKENS=4096
# 采样温度，值越大回复越随机；默认 0.7
LANMEI_AI_LLM_TEMPERATURE=0.7

# Embedding（OpenAI 兼容 API）
# 填入 API Key 后 RAG 向量检索自动启用（留空则向量召回与语义话题判定不可用）
LANMEI_AI_EMBEDDING_API_KEY=
# 接口地址需指向 OpenAI 兼容端点；默认 https://api.openai.com/v1
LANMEI_AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
# 向量模型名；默认 text-embedding-3-small（火山方舟 doubao-embedding 系列走多模态专用端点）
LANMEI_AI_EMBEDDING_MODEL=text-embedding-3-small
# 向量维度，必须与 Embedding 模型输出一致（默认 1024，与代码 vector(1024) 硬编码一致，
# 适配 BAAI/bge-m3 固定 1024 维；text-embedding-3-small 为 1536，需显式修改）；
# 启动迁移会按此值调整向量列（internal/database/migrate.go）
LANMEI_AI_EMBEDDING_DIM=1024
# 长期记忆余弦相似度门槛（0~1）；0.60 是偏宽松的初始值，需按嵌入模型和样本校准。
LANMEI_AI_MEMORY_MIN_SIMILARITY=0.60
# 长期记忆准入置信度/重要性门槛（0~1）；默认 0.65 / 0.55。
LANMEI_AI_MEMORY_MIN_CONFIDENCE=0.65
LANMEI_AI_MEMORY_MIN_IMPORTANCE=0.55

# 网易云点歌插件
# 网易云音乐 API 服务地址，如 http://ncm-api:3000（compose 中即内置服务，镜像为 binaryify 原版）。
# 为空时 /music 点歌提示"音乐服务未配置"
LANMEI_PLUGIN_NCM_URL=

# PostgreSQL 容器
# 以下为 docker-compose 使用的容器参数（非 LANMEI_ 前缀）；
# 本地开发时需与 LANMEI_DATABASE_URL 中的用户/密码/库名/端口一致
# POSTGRES_USER=lanmei
# POSTGRES_PASSWORD=lanmei
# POSTGRES_DB=lanmei
# POSTGRES_PORT=5432

# Redis 容器
# REDIS_PORT=6379

# 蓝妹服务端口映射（主机端口:容器端口）
# LANMEI_PORT=8080

# 管理面板前端（nginx 托管，manager-web 服务）
# 统一入口端口：http://<host>:${MANAGER_WEB_PORT} 托管前端并反代 /api
# 启用开关：Docker 部署由 docker-compose 固定 LANMEI_MANAGER_ENABLED=true，
# 本地开发可导出同名环境变量或在 config.toml 设 [manager] enabled=true。
# 以下凭据仅从环境变量读取、不落盘；缺失或过弱时 lanmei 启动失败：
LANMEI_MANAGER_ADMIN_USERNAME=admin         # 超级管理员用户名
LANMEI_MANAGER_ADMIN_PASSWORD=lanmei_admin  # 超级管理员密码（至少 8 位，否则启动失败）
LANMEI_MANAGER_SECRET_KEY=d5e9ca24a98f9b021e1821c789d6f005  # 凭据加密与 JWT 派生主密钥（至少 32 字符，或 32 字节 base64）
# 可选（WebAuthn passkey 需要域名 + HTTPS，通过 nginx 域名访问时配置 RPID；
# webauthn_origins 数组请直接在 config/config.toml 的 [manager] 中配置）：
#   LANMEI_MANAGER_WEBAUTHN_RPID=lanmei.example.com
# MANAGER_WEB_PORT=80

# 知识库系统
# 总开关：环境变量优先于 config.toml；置 true 后仍需在 config.toml 中存在启用的 knowledge.bases
LANMEI_KNOWLEDGE_ENABLED=true
# 每轮对话隐式召回注入的条数；默认 3，<=0 时回退 3
LANMEI_KNOWLEDGE_AUTO_RECALL_LIMIT=3
# 召回模式（default_recall_modes）、权重等只能改 config.toml，不支持环境变量
# 飞书知识库凭据（config.toml 中 provider = "feishu" 且以 env: 语法引用时生效）
# 需在飞书开放平台为企业自建应用开通 Wiki 与文档读取权限，
# 并将应用添加为目标知识空间的成员（管理员）
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
